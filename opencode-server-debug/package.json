{
  "name": "opencode-server-debug",
  "version": "0.0.1",
  "description": "OpenCode 按需远程服务器日志调试插件:自然语言经 SSH 拉取/分析远端 Linux 日志文件,零运行时依赖",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc -p .",
    "build:plugin": "bun build src/index.ts --outdir dist/plugin --target bun",
    "pack:bundle": "bash scripts/pack-bundle.sh"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.23",
    "@types/bun": "^1.3.0",
    "typescript": "^5.7.0"
  }
}
