{
  "name": "opencode-edge-debug",
  "version": "0.0.1",
  "description": "OpenCode 按需 Edge 浏览器调试插件:自然语言启动/关闭浏览器,抓取 Console 与网络日志,零重型框架依赖",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc -p .",
    "build:plugin": "bun build src/index.ts --outdir dist/plugin --target bun",
    "pack:bundle": "bash scripts/pack-bundle.sh"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.23",
    "@opencode-ai/sdk": "^1.18.23",
    "@types/bun": "^1.3.0",
    "typescript": "^5.7.0"
  }
}
